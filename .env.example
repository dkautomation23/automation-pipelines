# Copy to .env and fill in. The real .env is git-ignored - never commit secrets.

# --- webhook service ---------------------------------------------------
# Shared secret n8n must send in the X-Webhook-Token header.
# Leave empty to disable auth for local testing only.
WEBHOOK_TOKEN=replace-with-a-long-random-string

# Local audit trail. Written for every lead, before the remote sinks.
CSV_PATH=data/leads.csv

# --- Google Sheets sink (optional) -------------------------------------
SHEETS_ENABLED=false
# Path to the service-account JSON key. Keep it OUTSIDE the repository.
GOOGLE_CREDENTIALS_FILE=C:/secrets/service_account.json
# The long id from the spreadsheet URL: /spreadsheets/d/<THIS>/edit
SHEETS_SPREADSHEET_ID=
SHEETS_WORKSHEET=Leads

# --- notifications (optional) ------------------------------------------
# Any incoming webhook: Slack, Discord, a Telegram bridge or an n8n node.
NOTIFY_WEBHOOK_URL=
# Only notify when the lead score is at least this high (0 = always).
NOTIFY_MIN_SCORE=50

# --- used by the n8n workflow ------------------------------------------
PY_SERVICE_URL=http://localhost:8000
