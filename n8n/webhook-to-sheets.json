{
  "name": "Lead intake: Webhook -> Python -> Google Sheets -> Slack",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 300],
      "webhookId": "REPLACE_WITH_YOUR_WEBHOOK_ID",
      "notes": "Public entry point. Point your form / CRM / Zapier here."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PY_SERVICE_URL }}/webhook/lead",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Token",
              "value": "={{ $env.WEBHOOK_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || $json) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Clean via Python service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 300],
      "notes": "FastAPI does the normalisation, validation, scoring and de-duplication."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "valid-lead",
              "leftValue": "={{ $json.lead.is_valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Valid lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.SHEETS_SPREADSHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "lead_id": "={{ $json.lead.lead_id }}",
            "received_at": "={{ $json.lead.received_at }}",
            "name": "={{ $json.lead.name }}",
            "email": "={{ $json.lead.email }}",
            "phone": "={{ $json.lead.phone }}",
            "company": "={{ $json.lead.company }}",
            "source": "={{ $json.lead.source }}",
            "budget_eur": "={{ $json.lead.budget_eur }}",
            "score": "={{ $json.lead.score }}",
            "issues": "={{ $json.lead.issues.join('; ') }}"
          },
          "matchingColumns": ["lead_id"]
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Append to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 180],
      "notes": "Credentials live in n8n, never in this file."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'New lead ' + $json.lead.score + '/100: ' + $json.lead.name + ' <' + $json.lead.email + '> ' + ($json.lead.company || '') }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 180]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "minutes"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Hold for review",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [220, 420],
      "webhookId": "REPLACE_WITH_YOUR_WAIT_ID",
      "notes": "Invalid leads are parked instead of dropped - a human checks the queue."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: $json.status || 'queued', lead_id: $json.lead ? $json.lead.lead_id : null }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Respond to caller",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Clean via Python service", "type": "main", "index": 0 }]]
    },
    "Clean via Python service": {
      "main": [[{ "node": "Valid lead?", "type": "main", "index": 0 }]]
    },
    "Valid lead?": {
      "main": [
        [{ "node": "Append to Google Sheets", "type": "main", "index": 0 }],
        [{ "node": "Hold for review", "type": "main", "index": 0 }]
      ]
    },
    "Append to Google Sheets": {
      "main": [[{ "node": "Notify Slack", "type": "main", "index": 0 }]]
    },
    "Notify Slack": {
      "main": [[{ "node": "Respond to caller", "type": "main", "index": 0 }]]
    },
    "Hold for review": {
      "main": [[{ "node": "Respond to caller", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "tags": [{ "name": "portfolio" }, { "name": "lead-intake" }],
  "versionId": "1"
}
